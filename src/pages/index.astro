    margin-bottom: .8rem; 
  }
  
  .hero h1 span { 
    color: var(--dorado-global); 
  }
  
  .slogan-hero { 
    max-width: 650px; 
    margin: 0 auto 2.2rem; 
    font-size: clamp(1.15rem, 2.5vw, 1.35rem); 
    font-weight: 600;
    color: var(--crema-global);
    line-height: 1.4;
  }
  
  .btn { 
    display: inline-block; 
    background: var(--dorado-global); 
    color: var(--oscuro-global); 
    font-weight: 800; 
    padding: .85rem 2rem; 
    border-radius: 999px; 
    text-decoration: none; 
    transition: transform .2s, background-color .2s; 
  }
  
  .btn:hover, .btn:focus { 
    transform: translateY(-3px); 
    background-color: #f7c55a; 
  }

  main { max-width: 1150px; margin: auto; padding: 3.5rem 1.2rem; }
  .titulo { text-align: center; margin-bottom: 2.2rem; }
  .titulo h2 { font-size: clamp(1.8rem, 4vw, 2.5rem); color: var(--cafe-global); }
  .titulo p { max-width: 620px; margin: .5rem auto 0; }
  
  .grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); 
    gap: 1.5rem; 
  }
  
  .card { 
    background: #fff; 
    border-radius: 18px; 
    overflow: hidden; 
    box-shadow: 0 6px 18px rgba(0,0,0,.1); 
    display: flex; 
    flex-direction: column; 
    text-decoration: none; 
    transition: transform .25s, box-shadow .25s; 
  }
  .card:hover, .card:focus { transform: translateY(-6px); box-shadow: 0 12px 26px rgba(0,0,0,.18); }
  
  .card .banner { 
    height: 160px; 
    background-size: cover; 
    background-position: center; 
    background-repeat: no-repeat; 
  }
  
  .c1 .banner { background-image: linear-gradient(180deg, rgba(0,0,0,0.1), rgba(122, 52, 16, 0.7)), url('/img/card-platillos.jpg'); }
  .c2 .banner { background-image: linear-gradient(180deg, rgba(0,0,0,0.1), rgba(194, 81, 15, 0.7)), url('/img/card-bebidas.jpg'); }
  .c3 .banner { background-image: linear-gradient(180deg, rgba(0,0,0,0.1), rgba(43, 108, 143, 0.7)), url('/img/card-lugares.jpg'); }
  .c4 .banner { background-image: linear-gradient(180deg, rgba(0,0,0,0.1), rgba(26, 54, 93, 0.7)), url('/img/card-festivales.jpg'); }
  .c5 .banner { background-image: linear-gradient(180deg, rgba(0,0,0,0.1), rgba(122, 52, 16, 0.7)), url('/img/card-contacto.jpg'); }
  
  .card .cuerpo { padding: 1.3rem; display: flex; flex-direction: column; gap: .6rem; flex: 1; }
  .card h3 { color: var(--cafe-global); font-size: 1.4rem; }
  .card .ir { margin-top: auto; font-weight: 800; color: var(--naranja-global); }

  .footer-global { 
    width: 100% !important;
    background: #1b100a !important; 
    color: #ddd !important; 
    padding: 2.5rem 1.2rem !important; 
    text-align: center !important; 
    font-size: .9rem !important; 
    font-family: 'Nunito', system-ui, sans-serif !important;
  }
  .footer-global .redes { display: flex; justify-content: center; gap: .8rem; margin: 1rem 0 0; flex-wrap: wrap; }
  .footer-global .redes a { padding: .5rem 1.1rem; border-radius: 999px; font-weight: 700; text-decoration: none; color: #fff; }
  
  .fb { background: #1877f2; }
  .yt { background: #d62020; }
  .tw { background: #222; border: 1px solid #555; }
  .ig { background: linear-gradient(45deg, #f09433, #dc2743, #bc1888); }

  @media(max-width: 720px) {
    .menu-btn-global { display: block !important; }
    .nav-global { 
      display: none !important; 
      position: absolute !important; 
      left: 0 !important; 
      right: 0 !important; 
      top: 100% !important; 
      background: #fff !important; 
      padding: 1rem 1.2rem !important; 
      border-bottom: 3px solid var(--dorado-global) !important; 
      box-shadow: 0 6px 12px rgba(0,0,0,.1) !important; 
    }
    .nav-global.abierto { display: block !important; }
    .nav-global ul { flex-direction: column !important; gap: .8rem !important; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('menu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        const abierto = menu.classList.toggle('abierto');
        btn.setAttribute('aria-expanded', abierto);
      });
    }
  });
</script>
