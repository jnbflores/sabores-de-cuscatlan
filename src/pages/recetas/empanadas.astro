    <meta name="description" content="Aprende a preparar auténticas empanadas de plátano salvadoreñas rellenas de leche poleada o frijolitos dulces. Receta paso a paso, video e ingredientes.">
    <meta name="keywords" content="empanadas de platano salvadoreñas, receta de empanadas de platano, postres tipicos el salvador, empanadas de poleada">
    <meta name="author" content="Sabores de Cuscatlán">

