---
import Recetas from '../../layouts/Recetas.astro';
import imgEmpanadas from '../../assets/Empanadas.jpg';

const schemaData = {
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Empanadas de Plátano Salvadoreñas",
  "image": ["https://saboresdecuscatlan.sv/assets/Empanadas.jpg"],
  "author": {
    "@type": "Organization",
    "name": "Sabores de Cuscatlán"
  },
  "datePublished": "2026-10-28",
  "description": "Delicioso postre tradicional salvadoreño elaborado con puré de plátano maduro frito, relleno de leche poleada o frijoles molidos dulces y espolvoreado con azúcar.",
  "prepTime": "PT25M",
  "cookTime": "PT20M",
  "totalTime": "PT45M",
  "keywords": "empanadas de platano, empanadas salvadoreñas, leche poleada, frijoles dulces, postres tipicos el salvador",
  "recipeYield": "10 empanadas",
  "recipeCategory": "Postre Típico",
  "recipeCuisine": "Salvadoreña",
  "recipeIngredient": [
    "4 plátanos maduros",
    "Relleno: Leche poleada firme o frijoles molidos dulces",
    "Aceite vegetal abundante para freír",
    "Azúcar blanca para espolvorear"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Cocción del plátano",
      "text": "Hierve los plátanos cortados por la mitad (con cáscara) en agua hasta que la cáscara se rompa y la pulpa esté muy suave."
    },
    {
      "@type": "HowToStep",
      "name": "Elaboración de la masa",
      "text": "Retira la cáscara, aplasta la pulpa de los plátanos hasta hacer un puré fino sin grumos y déjalo enfriar bien."
    },
    {
      "@type": "HowToStep",
      "name": "Relleno y formado",
      "text": "Toma porciones de masa, haz una tortillita en la palma de tu mano, coloca una cucharada de leche poleada o frijoles en el centro y cierra doblando las orillas cuidando que no se salga el relleno."
    },
    {
      "@type": "HowToStep",
      "name": "Fritura y azucarado",
      "text": "Fríelas en un sartén con abundante aceite bien caliente hasta que estén doraditas. Escúrrelas y pásalas inmediatamente por azúcar blanca."
    }
  ]
};
---

