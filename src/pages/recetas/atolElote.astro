    <meta property="og:title" content="TPI115 - 2026 - Receta Auténtica de Atol de Elote | Sabores de Cuscatlán">
    <meta property="og:description" content="Aprende a preparar la tradicional bebida caliente y cremosa de elote tierno con canela y leche al estilo salvadoreño.">
    <meta property="og:type" content="article">
    <meta property="og:image" content={new URL('/img/og-cover.jpg', Astro.site)} />

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="TPI115 - 2026 - Receta Auténtica de Atol de Elote | Sabores de Cuscatlán">
    <meta name="twitter:description" content="Aprende a preparar la tradicional bebida caliente y cremosa de elote tierno con canela y leche al estilo salvadoreño.">
