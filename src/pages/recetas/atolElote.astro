    "@type": "Organization",
    "name": "Sabores de Cuscatlán"
  },
  "datePublished": "2026-10-28",
  "description": "Bebida caliente, dulce y espesa tradicional de El Salvador, elaborada con elote tierno recién desgranado, leche y rajas de canela.",
  "prepTime": "PT20M",
  "cookTime": "PT25M",
  "totalTime": "PT45M",
  "keywords": "atol de elote, atol salvadoreño, elote tierno, bebidas calientes el salvador, recetas tipicas salvadoreñas",
  "recipeYield": "6 porciones",
  "recipeCategory": "Bebida Típica",
  "recipeCuisine": "Salvadoreña",
  "recipeIngredient": [
    "10 elotes tiernos desgranados",
    "4 tazas de leche entera",
    "1 taza de agua",
    "Azúcar al gusto",
    "Rajas de canela al gusto",
    "1 pizca de sal"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Licuado del elote",
      "text": "Licúa los granos de elote tierno con la taza de agua hasta obtener una mezcla fina."
    },
    {
      "@type": "HowToStep",
      "name": "Colado",
      "text": "Pasa la mezcla por un colador de tela o manta de colar apretando bien para extraer todo el líquido."
    },
    {
      "@type": "HowToStep",
      "name": "Integración de ingredientes",
      "text": "Vierte el líquido obtenido en una olla honda, agrega la leche, la canela, el azúcar y la pizca de sal."
    },
    {
      "@type": "HowToStep",
      "name": "Cocción al fuego",
      "text": "Cocina a fuego medio sin dejar de mover en ningún momento con paleta de madera hasta que hierva y alcance una consistencia espesa."
    }
  ]
};
