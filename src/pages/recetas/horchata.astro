<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TPI115 - 2026 - Receta de Fresco de Horchata Salvadoreña | Sabores de Cuscatlán</title>
    
    <meta name="description" content="Aprende a preparar el auténtico fresco de horchata salvadoreña con semilla de morro, cacao y canela. Receta tradicional, video paso a paso e ingredientes.">
    <meta name="keywords" content="fresco de horchata salvadoreña, horchata de morro, bebidas tipicas el salvador, receta de horchata">
    <meta name="author" content="Sabores de Cuscatlán">

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-N8TWSLDHWF"></script>
