---
import Recetas from '../../layouts/Recetas.astro';
import imgHorchata from '../../assets/Horchata.jpg';

const schemaData = {
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Fresco de Horchata Salvadoreña",
  "image": ["https://saboresdecuscatlan.sv/assets/Horchata.jpg"],
  "author": {
    "@type": "Organization",
    "name": "Sabores de Cuscatlán"
  },
  "datePublished": "2026-10-28",
  "description": "La tradicional bebida fría salvadoreña elaborada a base de semilla de morro tostada, cacao, maní, pepitoria y especias.",
  "prepTime": "PT20M",
  "cookTime": "PT15M",
  "totalTime": "PT35M",
  "keywords": "horchata salvadoreña, fresco de horchata, semilla de morro, bebida tipica el salvador",
  "recipeYield": "8 porciones",
  "recipeCategory": "Bebida Típica",
  "recipeCuisine": "Salvadoreña",
  "recipeIngredient": [
    "1 libra de semilla de morro",
    "1/4 taza de maní",
    "1/4 taza de semillas de calabaza (pepitoria)",
    "2 onzas de cacao",
    "Canela al gusto",
    "Leche entera o vegetal al gusto",
    "Agua y azúcar al gusto"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Tostado de semillas",
      "text": "Tuesta todas las semillas (morro, maní, pepitoria, cacao) y la canela en un comal a fuego bajo cuidando que no se quemen."
    },
    {
      "@type": "HowToStep",
      "name": "Molienda",
      "text": "Lleva las semillas tostadas a un molino o procésalas finamente en seco en casa hasta obtener un polvo fino."
    },
    {
      "@type": "HowToStep",
      "name": "Extracción",
      "text": "Agrega agua al polvo obtenido y cuélalo usando una manta de colar, exprimiendo bien todo el extracto."
    },
    {
      "@type": "HowToStep",
      "name": "Mezclado y servido",
      "text": "Añade leche y azúcar al gusto al extracto, mezcla bien y sirve con abundante hielo."
    }
  ]
};
