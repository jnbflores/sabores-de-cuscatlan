---
import Recetas from '../../layouts/Recetas.astro';
import imgTorrejas from '../../assets/Torrejas.jpg';

const schemaData = {
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Torrejas en Miel Salvadoreñas",
  "image": ["https://saboresdecuscatlan.sv/assets/Torrejas.jpg"],
  "author": {
    "@type": "Organization",
    "name": "Sabores de Cuscatlán"
  },
  "datePublished": "2026-10-28",
  "description": "Postre tradicional salvadoreño elaborado con rodajas de torta de yema envueltas en huevo frito y sumergidas en una dulce miel de panela con canela.",
  "prepTime": "PT20M",
  "cookTime": "PT25M",
  "totalTime": "PT45M",
  "keywords": "torrejas en miel, torrejas salvadoreñas, dulce de panela, torta de yema, postres tipicos el salvador, semana santa",
  "recipeYield": "8 porciones",
  "recipeCategory": "Postre Típico",
  "recipeCuisine": "Salvadoreña",
  "recipeIngredient": [
    "1 torta de yema (pan tradicional salvadoreño)",
    "4 huevos enteros",
    "Aceite vegetal abundante para freír",
    "1 atado de dulce de panela (rapadura)",
    "Canela en rajas al gusto",
    "2 tazas de agua"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Corte del pan",
      "text": "Corta el pan de yema en rodajas de aproximadamente 2 centímetros de grosor."
    },
    {
      "@type": "HowToStep",
      "name": "Batido de huevo",
      "text": "Bate las claras de huevo a punto de nieve y luego incorpora suavemente las yemas."
    },
    {
      "@type": "HowToStep",
      "name": "Capeado y fritura",
      "text": "Pasa cada rodaja de pan por el huevo batido asegurándote de que quede bien cubierta y fríela en un sartén con abundante aceite caliente por ambos lados hasta dorar."
    },
    {
      "@type": "HowToStep",
      "name": "Elaboración de la miel y bañado",
      "text": "Aparte, derrite el dulce de panela en una olla con el agua y rajas de canela a fuego medio hasta obtener un jarabe o miel espesa. Sumerge las torrejas en la miel caliente para que la absorban bien antes de servir."
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TPI115 - 2026 - Receta de Torrejas en Miel Salvadoreñas | Sabores de Cuscatlán</title>
    
    <meta name="description" content="Aprende a preparar las tradicionales torrejas en miel de panela al estilo salvadoreño. Receta típica con torta de yema, miel de atado, video paso a paso e ingredientes.">
    <meta name="keywords" content="torrejas en miel salvadoreñas, receta de torrejas, postres tipicos el salvador, dulce de panela">
    <meta name="author" content="Sabores de Cuscatlán">

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-N8TWSLDHWF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-N8TWSLDHWF');
