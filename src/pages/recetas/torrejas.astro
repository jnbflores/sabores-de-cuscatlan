    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <meta property="og:title" content="TPI115 - 2026 - Receta Auténtica de Torrejas en Miel | Sabores de Cuscatlán">
    <meta property="og:description" content="Guía paso a paso para preparar las emblemáticas torrejas salvadoreñas envueltas en huevo y bañadas en dulce miel de panela.">
    <meta property="og:type" content="article">
    <meta property="og:image" content={new URL('/img/og-cover.jpg', Astro.site)} />

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="TPI115 - 2026 - Receta Auténtica de Torrejas en Miel | Sabores de Cuscatlán">
    <meta name="twitter:description" content="Guía paso a paso para preparar las emblemáticas torrejas salvadoreñas envueltas en huevo y bañadas en dulce miel de panela.">
    <meta name="twitter:image" content={new URL('/img/og-cover.jpg', Astro.site)} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
</head>
<body>
  <Recetas titulo="Torrejas en Miel" descripcion="Pan de yema especial, cortado en rodajas gruesas, envuelto en huevo frito y bañado en miel." imagen={imgTorrejas}>
    <h2>Ingredientes</h2>
    <ul>
      <li>1 torta de yema (pan tradicional)</li>
      <li>4 huevos enteros</li>
      <li>Aceite abundante para freír</li>
      <li>Miel: 1 atado de dulce de panela, canela y agua</li>
    </ul>

    <h2>Preparación</h2>
    <ol>
      <li>Corta el pan de yema en rodajas de aproximadamente 2 centímetros de grosor.</li>
      <li>Bate las claras de huevo a punto de nieve y luego incorpora las yemas.</li>
      <li>Pasa cada rodaja de pan por el huevo batido asegurándote de que quede bien cubierta y fríela en aceite caliente por ambos lados.</li>
      <li>Aparte, derrite la panela con agua y canela para hacer la miel. Sumerge las torrejas en la miel caliente para que la absorban.</li>
    </ol>

    <h2>Video de Preparación</h2>
    <div class="contenedor-video">
      <iframe 
        src="https://www.youtube.com/embed/Bi9hncOmFKo" 
        title="Video paso a paso - Torrejas en Miel Salvadoreñas" 
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
        allowfullscreen>
      </iframe>
    </div>
  </Recetas>
</body>
</html>