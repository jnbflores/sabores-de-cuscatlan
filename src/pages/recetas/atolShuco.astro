  },
  "datePublished": "2026-10-28",
  "description": "Bebida ancestral salvadoreña de maíz negrito fermentado, servida tradicionalmente en huacal de morro con frijoles enteros, alhuashte y chile.",
  "prepTime": "PT1440M",
  "cookTime": "PT30M",
  "totalTime": "PT1470M",
  "keywords": "atol shuco, atol shuco salvadoreño, maiz fermentado, alhuashte, bebidas ancestrales el salvador",
  "recipeYield": "6 porciones",
  "recipeCategory": "Bebida Típica",
  "recipeCuisine": "Salvadoreña",
  "recipeIngredient": [
    "1 libra de maíz negrito o morado",
    "1 taza de frijoles negros cocidos enteros",
    "Polvo de alhuashte (semilla de ayote molida) al gusto",
    "Agua",
    "Sal al gusto",
    "Chile liquido o en gotas (opcional)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Fermentación del maíz",
      "text": "Lava el maíz y déjalo reposar en agua por 1 o 2 días para que fermente levemente (el toque 'shuco')."
    },
    {
      "@type": "HowToStep",
      "name": "Molienda y colado",
      "text": "Muele el maíz fermentado y cuélalo con abundante agua utilizando un colador fino o manta."
    },
    {
      "@type": "HowToStep",
      "name": "Cocción",
      "text": "Cocina a fuego lento moviendo constantemente con paleta de madera hasta que espese y se cueza bien. Añade sal al gusto."
    },
    {
      "@type": "HowToStep",
      "name": "Servido y acompañamiento",
      "text": "Sirve caliente en huacal de morro, agregando una cucharada de frijoles negros enteros, espolvoreando alhuashte y unas gotas de chile al gusto."
    }
  ]
};
