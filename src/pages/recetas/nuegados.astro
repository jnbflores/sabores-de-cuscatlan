  "image": ["https://saboresdecuscatlan.sv/assets/Nuegados.jpg"],
  "author": {
    "@type": "Organization",
    "name": "Sabores de Cuscatlán"
  },
  "datePublished": "2026-10-28",
  "description": "Bocaditos fritos tradicionales de El Salvador preparados a base de yuca molida, servidos calientes y bañados con miel de dulce de panela.",
  "prepTime": "PT20M",
  "cookTime": "PT20M",
  "totalTime": "PT40M",
  "keywords": "nuegados de yuca, nuegados salvadoreños, miel de panela, chilate, antojitos tipicos el salvador",
  "recipeYield": "12 nuegados",
  "recipeCategory": "Postre Típico",
  "recipeCuisine": "Salvadoreña",
  "recipeIngredient": [
    "2 libras de yuca fresca",
    "2 huevos",
    "1 cucharadita de polvo de hornear",
    "1 pizca de sal",
    "Aceite vegetal para freír",
    "1/2 atado de dulce de panela (rapadura)",
    "Canela en rajas al gusto",
    "1 taza de agua"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Molienda de la yuca",
      "text": "Pela, lava y muele o ralla la yuca muy finamente hasta formar una masa homogénea."
    },
    {
      "@type": "HowToStep",
      "name": "Preparación de la masa",
      "text": "Mezcla la yuca molida con los huevos, el polvo de hornear y la pizca de sal hasta integrar completamente."
    },
    {
      "@type": "HowToStep",
      "name": "Formado y fritura",
      "text": "Toma porciones de masa, forma tortitas gruesas y fríelas en un sartén con aceite bien caliente hasta que se doren por ambos lados."
    },
    {
      "@type": "HowToStep",
      "name": "Preparación de la miel y servido",
      "text": "Aparte, derrite el dulce de panela con el agua y la canela a fuego medio hasta obtener un jarabe espeso. Sirve los nuégados calientes bañados generosamente con la miel."
    }
  ]
};
