---
import Recetas from '../../layouts/Recetas.astro';
import imgCanoas from '../../assets/Canoas.jpg';

const schemaData = {
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Canoas de Leche Salvadoreñas",
  "image": ["https://saboresdecuscatlan.sv/assets/Canoas.jpg"],
  "author": {
    "@type": "Organization",
    "name": "Sabores de Cuscatlán"
  },
  "datePublished": "2026-10-28",
  "description": "Postre salvadoreño hecho con plátanos maduros fritos enteros, ahuecados en forma de canoa, rellenos de leche poleada y decorados con canela.",
  "prepTime": "PT15M",
  "cookTime": "PT20M",
  "totalTime": "PT35M",
  "keywords": "canoas de leche, canoas de platano, leche poleada, postres tipicos el salvador, plátanos fritos",
  "recipeYield": "3 porciones",
  "recipeCategory": "Postre Típico",
  "recipeCuisine": "Salvadoreña",
  "recipeIngredient": [
    "3 plátanos bien maduros (cáscara casi negra)",
    "1 taza de leche poleada (maicena preparada)",
    "Canela en polvo para decorar",
    "Aceite vegetal para freír"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Fritura del plátano",
      "text": "Pela los plátanos maduros y fríelos enteros en un sartén con aceite a fuego medio hasta que estén bien dorados por todos sus lados."
    },
    {
      "@type": "HowToStep",
      "name": "Apertura en canoa",
      "text": "Sácalos, colócalos sobre papel absorbente y hazles un corte a lo largo por el centro sin atravesarlos por completo para darles forma de canoa."
    },
    {
      "@type": "HowToStep",
      "name": "Preparación de la manjar",
      "text": "Prepara la leche poleada (leche, maicena, azúcar, vainilla) en una olla a fuego medio moviendo constantemente hasta que espese."
    },
    {
      "@type": "HowToStep",
      "name": "Relleno y decorado",
      "text": "Rellena la hendidura de cada plátano frito con abundante leche poleada caliente y espolvorea canela en polvo al gusto por encima."
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TPI115 - 2026 - Receta de Canoas de Leche Salvadoreñas | Sabores de Cuscatlán</title>
    
    <meta name="description" content="Aprende a preparar deliciosas canoas de leche salvadoreñas. Receta tradicional con plátanos maduros fritos, leche poleada, canela y video paso a paso.">
    <meta name="keywords" content="canoas de leche salvadoreñas, canoas de platano, postres tipicos el salvador, receta de canoas de leche">
    <meta name="author" content="Sabores de Cuscatlán">

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-N8TWSLDHWF"></script>
