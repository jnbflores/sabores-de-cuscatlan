<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TPI115 - 2026 - Receta de Fresco de Cebada Salvadoreño | Sabores de Cuscatlán</title>
    
    <meta name="description" content="Aprende a preparar el icónico fresco de cebada salvadoreño de color rosado. Receta tradicional con especias, esencia de fresa, video e ingredientes.">
    <meta name="keywords" content="fresco de cebada salvadoreño, cebada rosada, bebidas tipicas el salvador, receta fresco de cebada">
    <meta name="author" content="Sabores de Cuscatlán">

