import imgCebada from '../../assets/Cebada.jpg';

const schemaData = {
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Fresco de Cebada Salvadoreño",
  "image": ["https://saboresdecuscatlan.sv/assets/Cebada.jpg"],
  "author": {
    "@type": "Organization",
    "name": "Sabores de Cuscatlán"
  },
  "datePublished": "2026-10-28",
  "description": "Bebida tradicional de El Salvador caracterizada por su color rosado, aroma a especias dulces y toque de fresa y vainilla.",
  "prepTime": "PT15M",
  "cookTime": "PT10M",
  "totalTime": "PT25M",
  "keywords": "fresco de cebada, cebada salvadoreña, fresca rosada, bebidas tipicas el salvador",
  "recipeYield": "6 porciones",
  "recipeCategory": "Bebida Típica",
  "recipeCuisine": "Salvadoreña",
  "recipeIngredient": [
    "1/2 taza de harina de cebada o trigo tostado",
    "1 litro de agua",
    "Leche evaporada al gusto",
    "Esencia de fresa y de vainilla al gusto",
    "Canela, clavo de olor y pimienta gorda",
    "Azúcar al gusto",
    "Colorante rojo comestible (opcional)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Infusión de especias",
      "text": "Hierve el agua con la canela, el clavo de olor y la pimienta gorda. Deja enfriar y cuela la infusión."
    },
    {
      "@type": "HowToStep",
      "name": "Mezclado de harina",
      "text": "Licúa la harina de cebada con el agua especiada hasta integrar por completo."
    },
    {
      "@type": "HowToStep",
      "name": "Sazonado y color",
      "text": "Añade la leche evaporada, el azúcar, las esencias de fresa y vainilla, y un toque de colorante rojo para obtener el característico tono rosado."
    },
    {
      "@type": "HowToStep",
      "name": "Servido",
      "text": "Mezcla bien y sirve helado con bastante hielo."
    }
  ]
};
