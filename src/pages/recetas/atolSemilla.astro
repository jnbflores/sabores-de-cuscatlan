---
import Recetas from '../../layouts/Recetas.astro';
import imgAtolSemilla from '../../assets/atolSemilla.jpg';

const schemaData = {
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Atol de Semilla de Marañón Salvadoreño",
  "image": ["https://saboresdecuscatlan.sv/assets/atolSemilla.jpg"],
  "author": {
    "@type": "Organization",
    "name": "Sabores de Cuscatlán"
  },
  "datePublished": "2026-10-28",
  "description": "Bebida caliente y reconfortante de la gastronomía salvadoreña, elaborada con semillas de marañón tostadas, leche y canela.",
  "prepTime": "PT15M",
  "cookTime": "PT20M",
  "totalTime": "PT35M",
  "keywords": "atol de semilla de marañon, atol salvadoreño, semilla de marañon, bebidas calientes el salvador, recetas tradicionales",
  "recipeYield": "6 porciones",
  "recipeCategory": "Bebida Típica",
  "recipeCuisine": "Salvadoreña",
  "recipeIngredient": [
    "1 libra de semilla de marañón tostada",
    "1 litro de leche",
    "Azúcar al gusto",
    "Rajas de canela al gusto"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Triturado",
      "text": "Tritura finamente las semillas de marañón tostadas en la licuadora o procesador hasta obtener un polvo fino."
    },
    {
      "@type": "HowToStep",
      "name": "Mezclado",
      "text": "Mezcla el polvo de semilla de marañón obtenido con la leche. Si prefieres un atol muy fino, puedes colarlo."
    },
    {
      "@type": "HowToStep",
      "name": "Cocción",
      "text": "Lleva la mezcla a una olla a fuego medio junto con las rajas de canela y el azúcar al gusto."
    },
    {
      "@type": "HowToStep",
      "name": "Espesado y servido",
      "text": "Remueve constantemente con una paleta para evitar que se pegue hasta que hierva, alcance la consistencia deseada y sirve caliente."
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es">
