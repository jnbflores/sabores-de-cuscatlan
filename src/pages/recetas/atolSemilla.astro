    <meta name="description" content="Aprende a preparar el delicioso atol de semilla de marañón salvadoreño. Receta tradicional con leche, canela, video paso a paso e ingredientes.">
    <meta name="keywords" content="atol de semilla de marañon salvadoreño, atol de marañon, bebidas tipicas el salvador, receta atol de marañon">
    <meta name="author" content="Sabores de Cuscatlán">

