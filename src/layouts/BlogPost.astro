---
import { Image } from 'astro:assets';

const { titulo, descripcion, imagen } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo} | Recetas Salvadoreñas</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <div class="detalle-contenedor">
    <div class="columna-imagen">
      <img src={imagen || '/placeholder.jpg'} alt={titulo} />
    </div>

    <div class="columna-texto">
      <h1>{titulo}</h1>
      <div class="subtitulo">{descripcion}</div>
      
      <!-- Contenido inyectado con ingredientes, pasos y videos -->
      <div class="contenido-receta">
        <slot />
      </div>
      
      <div class="grupo-botones">
        <a href="/bebidas-postres" class="btn-volver">&larr; Volver a la lista</a>
        <a href="/" class="btn-inicio">Inicio</a>
      </div>
    </div>
  </div>

  <style>
    body { 
      font-family: system-ui, -apple-system, sans-serif; 
      background: #1a1a1a; 
      margin: 0; 
      padding: 40px 20px; 
      min-height: 100vh;
      display: flex;
      align-items: center;
      box-sizing: border-box;
    }
    
    .detalle-contenedor {
      display: flex;
      flex-direction: column;
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
      background: white;
      box-shadow: 0 15px 25px rgba(0,0,0,0.4);
      border-radius: 16px;
      overflow: hidden;
    }

    @media (min-width: 768px) {
      .detalle-contenedor { flex-direction: row; }
    }

    .columna-imagen {
      flex: 1;
      background: #e5e5e5;
    }
    .columna-imagen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      min-height: 350px;
    }

    .columna-texto {
      flex: 1.2;
      padding: 40px;
    }
    .columna-texto h1 { 
      margin-top: 0; 
      color: #993300; 
      font-family: Georgia, serif;
      font-size: 2.3rem; 
      margin-bottom: 10px;
    }
    .subtitulo { 
      color: #666; 
      font-size: 1.1rem; 
      margin-bottom: 20px; 
      border-bottom: 1px solid #eee; 
      padding-bottom: 15px; 
      line-height: 1.5;
    }
    
    /* Estilos para el contenido inyectado */
    .contenido-receta { line-height: 1.6; color: #444; }
    .contenido-receta :global(h2), .contenido-receta :global(h3) { 
      color: #993300; 
      margin-top: 25px; 
      font-family: Georgia, serif;
    }
    .contenido-receta :global(ul), .contenido-receta :global(ol) {
      padding-left: 20px;
    }

    /* ESTILOS OPTIMIZADOS PARA CONTENEDOR DE VIDEO Y YOUTUBE */
    .contenido-receta :global(.contenedor-video) {
      position: relative;
      padding-bottom: 56.25%; /* Proporción 16:9 */
      height: 0;
      overflow: hidden;
      border-radius: 12px;
      margin-top: 20px;
      margin-bottom: 20px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
      border: 2px solid #f0e4d2;
      background: #000;
    }

    .contenido-receta :global(.contenedor-video iframe) {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
      border-radius: 10px;
    }

    .grupo-botones {
      display: flex;
      gap: 12px;
      margin-top: 35px;
    }

    .btn-volver { 
      display: inline-block; 
      color: #ffffff; 
      background-color: #c2510f;
      text-decoration: none; 
      font-weight: bold; 
      padding: 10px 20px;
      border-radius: 25px;
      transition: background-color 0.2s ease;
    }
    .btn-volver:hover {
      background-color: #7a3410;
    }

    .btn-inicio {
      display: inline-block;
      color: #7a3410;
      text-decoration: none;
      font-weight: bold;
      border: 2px solid #7a3410;
      padding: 10px 20px;
      border-radius: 25px;
      transition: all 0.2s ease;
    }
    .btn-inicio:hover {
      background-color: #7a3410;
      color: #ffffff;
    }
  </style>
</body>
</html>