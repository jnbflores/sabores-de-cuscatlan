---
import { Image } from 'astro:assets';
const { 
  titulo, 
  descripcion, 
  imagen, 
  seccionNombre = "Bebidas y Postres", 
  seccionUrl = "/bebidas-postres" 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{titulo} | Recetas Salvadoreñas</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="fondo-receta">
  <div class="contenedor-receta">
    
    <!-- Lado Izquierdo: Imagen -->
    <div class="columna-imagen">
      {imagen ? (
        <Image src={imagen} alt={titulo} width={800} height={800} format="webp" />
      ) : (
        <div class="imagen-placeholder">Sin imagen</div>
      )}
    </div>

    <!-- Lado Derecho: Contenido -->
    <div class="columna-texto">
      <h1>{titulo}</h1>
      <p class="descripcion">{descripcion}</p>
      
      <!-- Aquí se inyectan los ingredientes, pasos y videos -->
      <div class="contenido-receta">
        <slot />
      </div>
      
      <!-- Botones de navegación de retorno -->
      <div class="grupo-botones-volver">
        <a href={seccionUrl} class="btn-volver">&larr; Volver a {seccionNombre}</a>
        <a href="/" class="btn-volver-inicio">Inicio</a>
      </div>
    </div>

  </div>
</body>
</html>

<style>
  .fondo-receta {
    background-color: #1a1a1a; 
    min-height: 100vh;
    padding: 40px 20px;
    font-family: system-ui, -apple-system, sans-serif;
    display: flex;
    align-items: center;
    margin: 0;
  }

  .contenedor-receta {
    display: flex;
    flex-direction: column;
    max-width: 1100px;
    margin: 0 auto;
    background: #fdf5e6; 
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 15px 25px rgba(0,0,0,0.5);
    width: 100%;
  }

  @media (min-width: 768px) {
    .contenedor-receta { flex-direction: row; }
  }

  .columna-imagen {
    flex: 1;
    background: #e5e7eb;
  }
  
  .columna-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 350px;
  }

  .columna-texto {
    flex: 1.2;
    padding: 40px;
    background-color: #ffffff;
  }

  .columna-texto h1 {
    color: #993300;
    margin-top: 0;
    font-family: Georgia, serif;
    font-size: 2.5rem;
    margin-bottom: 10px;
  }

  .descripcion {
    color: #666;
    font-size: 1.1rem;
    border-bottom: 1px solid #eaeaea;
    padding-bottom: 20px;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .contenido-receta :global(h2), .contenido-receta :global(h3) {
    color: #d97706;
    margin-top: 25px;
    margin-bottom: 10px;
    font-family: Georgia, serif;
  }
  
  .contenido-receta :global(ul), .contenido-receta :global(ol) {
    color: #374151;
    line-height: 1.6;
    padding-left: 20px;
  }

  .contenido-receta :global(li) {
    margin-bottom: 8px;
  }

  /* ESTILOS OPTIMIZADOS PARA CONTENEDOR DE VIDEO Y YOUTUBE */
  .contenido-receta :global(.contenedor-video) {
    position: relative;
    padding-bottom: 56.25%; /* Relación de aspecto 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 12px;
    margin-top: 18px;
    margin-bottom: 20px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    border: 2px solid #f3e8d5;
    background: #000;
  }

  .contenido-receta :global(.contenedor-video iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 10px;
  }

  .grupo-botones-volver {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 40px;
  }

  .btn-volver {
    display: inline-block;
    color: #ffffff;
    background-color: #c2510f;
    text-decoration: none;
    font-weight: bold;
    border: 2px solid #c2510f;
    padding: 10px 20px;
    border-radius: 25px;
    transition: all 0.2s ease;
  }

  .btn-volver:hover {
    background-color: #7a3410;
    border-color: #7a3410;
  }

  .btn-volver-inicio {
    display: inline-block;
    color: #7a3410;
    text-decoration: none;
    font-weight: bold;
    border: 2px solid #7a3410;
    padding: 10px 20px;
    border-radius: 25px;
    transition: all 0.2s ease;
  }

  .btn-volver-inicio:hover {
    background-color: #7a3410;
    color: #ffffff;
  }
</style>